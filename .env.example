# Configurações do PF2e Tools
# Copie este arquivo para .env e preencha com suas chaves

# Tradução das descrições da AON. As duas são gratuitas e OPCIONAIS: a cadeia
# tenta o Gemini primeiro e cai para o Groq. Sem nenhuma chave, as descrições
# aparecem em inglês. Configure as duas para ter fallback.

# Google AI Studio — tradutor primário (gemini-3.1-flash-lite)
# Obtenha GRATUITAMENTE em: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui

# Groq — fallback (openai/gpt-oss-120b)
# Obtenha GRATUITAMENTE em: https://console.groq.com/keys
GROQ_API_KEY=sua_chave_aqui

# Porta do servidor API (opcional, padrão: 3001)
# PORT=3001

# ---------------------------------------------------------------------------
# Estado compartilhado da mesa (Ficha Virtual)
# ---------------------------------------------------------------------------
# PV, slots de magia, pontos de foco e condições são compartilhados entre todos
# os jogadores. É OPCIONAL: sem estas variáveis o estado fica só no aparelho de
# cada um (localStorage), exatamente como era antes.
#
# Na Vercel: Storage → Upstash Redis (plano free basta). A integração injeta
# KV_REST_API_URL/KV_REST_API_TOKEN sozinha, não precisa colar nada.
# Direto na Upstash (https://console.upstash.com): use o par UPSTASH_*.
KV_REST_API_URL=https://sua-instancia.upstash.io
KV_REST_API_TOKEN=seu_token_aqui

# ---------------------------------------------------------------------------
# Imagens do Mapa de Combate (mapas e tokens)
# ---------------------------------------------------------------------------
# OPCIONAL: sem ele as imagens ficam só no aparelho de quem enviou (IndexedDB)
# e os outros veem o grid e os tokens com iniciais.
#
# Na Vercel: Storage → Blob → Create (plano Hobby basta). A integração injeta a
# variável sozinha; para o dev local, copie o token do painel do Blob.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_seu_token_aqui
