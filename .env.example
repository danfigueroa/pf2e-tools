# Configurações do PF2e Tools
# Copie este arquivo para .env e preencha com suas chaves

# Tradução das descrições da AON. As duas são gratuitas e OPCIONAIS: a cadeia
# tenta o Gemini primeiro e cai para o Groq. Sem nenhuma chave, as descrições
# aparecem em inglês. Configure as duas para ter fallback.

# Google AI Studio — tradutor primário (gemini-3.1-flash-lite)
# Obtenha GRATUITAMENTE em: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_aqui

# Groq — fallback (openai/gpt-oss-120b)
# Obtenha GRATUITAMENTE em: https://console.groq.com/keys
GROQ_API_KEY=sua_chave_aqui

# Porta do servidor API (opcional, padrão: 3001)
# PORT=3001

# ---------------------------------------------------------------------------
# Supabase (Postgres + Realtime + Storage) — estado da mesa, fichas publicadas,
# feed de rolagens, mapas, imagens e o cache de traduções. OPCIONAL: sem ele o
# app funciona, mas tudo fica no aparelho de cada um (localStorage/IndexedDB).
# ---------------------------------------------------------------------------
# Painel do projeto → Project Settings → API Keys (use as chaves novas, não as
# legadas anon/service_role). Pela CLI: npx supabase projects api-keys --reveal
SUPABASE_URL=https://seu-projeto.supabase.co
# Só no servidor: passa por cima das regras de acesso (RLS). Nunca no frontend.
SUPABASE_SECRET_KEY=sb_secret_sua_chave_aqui
# Frontend (pública): Realtime e a sessão anônima de cada aparelho.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_aqui
# Senha do banco (definida na criação do projeto): backup e scripts de migração.
SUPABASE_DB_PASSWORD=sua_senha_aqui
# String de conexão do POOLER em modo sessão, para scripts/check-migrations.mjs
# (e o segredo de mesmo nome no GitHub, para o backup semanal):
# postgresql://postgres.<ref>:<senha>@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres.seu-ref:sua_senha@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# Senha da criptografia do backup semanal (segredo BACKUP_PASSPHRASE no GitHub).
BACKUP_PASSPHRASE=uma_senha_longa
